# CityMart Environment Variables Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Duplicate this file and rename it to ".env".
# 2. Fill in your project-specific values.
# 3. NEVER commit your actual ".env" or ".env.*" files to GitHub or version control.
# ==============================================================================

# Firebase Public Client Configuration
# (These identify your Firebase project to Google APIs)
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyYourApiKeyHere
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=citymart-69b52.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://citymart-69b52-default-rtdb.firebaseio.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=citymart-69b52
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=citymart-69b52.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=997601669962
EXPO_PUBLIC_FIREBASE_APP_ID=1:997601669962:android:c6f16c79614df49ca7c7b3

# Google OAuth Configuration
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Payment Gateway (Client-side Publishable Keys Only)
# WARNING: NEVER put secret keys (sk_live_..., api_secret) in this app!
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key

# Environment
EXPO_PUBLIC_APP_ENV=development
