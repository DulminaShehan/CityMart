rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Shop logos & storefront banners (publicly readable for customer marketplace browsing)
    match /shops/{shopId}/branding/{allImages=**} {
      allow read: if true;
      allow write: if request.auth != null && 
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // Sensitive business & legal verification documents (private!)
    // Only accessible by the shop owner and admin reviewers
    match /shops/{shopId}/documents/{allDocs=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
        request.resource.size < 10 * 1024 * 1024 &&
        (request.resource.contentType.matches('application/pdf') || 
         request.resource.contentType.matches('image/.*'));
    }
  }
}
